{
  "name": "elghareeb-portfolio",
  "description": "Ahmed Elghareeb - Personal Portfolio",
  "engines": {
    "bun": ">=1.4.4"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "typecheck": "bun run build.types",
    "test": "bun test",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\" \"worker/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts*\" \"worker/**/*.ts\" --fix",
    "preview": "bun run build && bunx serve dist",
    "qwik": "qwik",
    "clean": "rm -rf dist server tmp .qwik node_modules/.vite node_modules/.cache/imagetools",
    "update": "bun outdated"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.3",
    "@builder.io/qwik-city": "^1.20.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-qwik": "^1.20.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "valibot": "^1.5.0",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
