// The site is static files served as Worker assets. `.github/workflows/deploy.yml` builds and
// deploys on every push to main; `wrangler deploy` after a local build does the same by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "account_id": "f8bc153fe7e73b012806460d95005a5a",
  "compatibility_date": "2025-12-07",
  // The domain is a custom domain of the Worker: the deploy creates and keeps its DNS record
  "routes": [{ "pattern": "elghareeb.space", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
