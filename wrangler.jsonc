// The static site served as Worker assets, with one route of code in front of it that records
// interactions (worker/index.ts). `.github/workflows/deploy.yml` builds and deploys on every push
// to main; `wrangler deploy` after a local build does the same by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "worker/index.ts",
  "account_id": "f8bc153fe7e73b012806460d95005a5a",
  "compatibility_date": "2025-12-07",
  // The custom domains below are the only addresses; no workers.dev or preview URLs
  "workers_dev": false,
  "preview_urls": false,
  // Both hostnames are custom domains of the Worker: the deploy creates and keeps their DNS
  // records. A Redirect Rule on the zone sends www to the bare domain.
  "routes": [
    { "pattern": "elghareeb.space", "custom_domain": true },
    { "pattern": "www.elghareeb.space", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/stats"],
  },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "site_events" }],
  // /stats also needs two secrets, set once with `wrangler secret put`: STATS_PASSWORD and
  // CF_ANALYTICS_TOKEN (an API token with Account Analytics: Read)
  "vars": {
    "ACCOUNT_ID": "f8bc153fe7e73b012806460d95005a5a",
    "WEB_ANALYTICS_SITE": "810f6774e84a47cbb01814c432051ad1",
  },
}
