// Cloudflare Workers Builds runs `bun run build` and then `bunx wrangler deploy`
// on every push to main. This serves the static site in dist/ as Worker assets.
{
  "name": "personal-site",
  "compatibility_date": "2025-12-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
